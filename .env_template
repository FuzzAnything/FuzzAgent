# This is a template for the .env file. Copy this file to .env and fill in the values.

## Fixed values
export CONTAINER_NAME=fuzzagent-test
export COMMAND='uv run main.py'
export WRITE_MODE=rw
export FUZZING_ENGINE=afl++
export AFL_SKIP_CPUFREQ=1
export FUZZAGENT_AUTO_CLEAN=1


## llm values
export OPENAI_BASE_URL=https://xxx/v1
export OPENAI_API_KEY=xxx
export OPENAI_MODEL=xxx

## project-specific values
export SRC_DIR=/path/to/source
export REPO_BASE_NAME=project_name # e.g., openssl
export RAW_OUTPUT_DIR=/path/to/output

### Used for the web search feature. If not set, the web search feature will fail.
export GITHUB_TOKEN=xxx
