#!/usr/bin/env python3

from func_cov_utils import FunctionCoverageCollection
from project_utils import ProjectUtils
from show_code_coverage import CoverageUtils
import argparse


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Show function code coverage')
    parser.add_argument('page', type=int, help='The page number to show')
    parser.add_argument('search_func', type=str, nargs='?', default='', help='The function name to search')
    parser.add_argument('--fuzzer_id', type=int, required=False, default=None, help='The fuzzer ID to show')
    args = parser.parse_args()
    fuzzer_id = args.fuzzer_id
    if fuzzer_id is not None:
        CoverageUtils.execute_coverage_collection_pipeline(fuzzer_id)
        coverage_dir = ProjectUtils.get_fuzzer_coverage_dir(fuzzer_id)
    else:
        CoverageUtils.gather_whole_project_coverage_pipeline()
        coverage_dir = ProjectUtils.get_project_coverage_dir()
    coverage = FunctionCoverageCollection(coverage_dir)
    coverage.display(page=args.page, search_func=args.search_func)