#!/usr/bin/env python3

import os
import sys
import json
import argparse
import subprocess
import glob
from pathlib import Path
import shutil
from project_utils import ProjectUtils

def crash_artifact_analysis(fuzzer_id: int, crash_artifact_path: str, timeout=60):
    """
    Execute the crash artifact on the fuzzer binary and gather information from the crash stacktrace and source code.
    
    Args:
        fuzzer_id (int): The fuzzer instance ID to generate the crash report for. E.g., 000, 001, etc.
        crash_artifact_path (str): Path to the crash artifact
        timeout (int): Timeout for the fuzzer binary (default: 30)
        
    Returns:
        int: 0 on success, 1 on failure
    """
    fuzzer_binary = ProjectUtils.get_fuzzer_binary_by_id(fuzzer_id)
    if not os.path.exists(fuzzer_binary):
        raise Exception(f"[!] Error: fuzzer binary {fuzzer_binary} does not exist! ")
    
    if not os.path.exists(crash_artifact_path):
        raise Exception(f"[!] Error: crash artifact {crash_artifact_path} does not exist! ")
    
    tmp_crash_dir = os.path.join("/tmp", os.path.basename(crash_artifact_path))
    if os.path.exists(tmp_crash_dir):
        shutil.rmtree(tmp_crash_dir)
    os.makedirs(tmp_crash_dir, exist_ok=True)
    tmp_crash_file = os.path.join(tmp_crash_dir, os.path.basename(crash_artifact_path))
    
    tmp_crash_report_dir = os.path.join(tmp_crash_dir, "crash_report")
    os.makedirs(tmp_crash_report_dir, exist_ok=True)

    cmd = ['casr-san', '-o', os.path.join(tmp_crash_report_dir, "asan.casrep"), '--', fuzzer_binary, crash_artifact_path]
    asan_output = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)

    # Run the casr tool to generate crash report
    cmd = ['casr-ubsan', '-i', os.path.dirname(crash_artifact_path), '-o', tmp_crash_report_dir, 
           '-t', str(timeout), '--', fuzzer_binary, "@@"]
    
    ubsan_output = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    if asan_output.returncode != 0 and ubsan_output.returncode != 0:
        err_msg = asan_output.stderr.decode("utf-8", errors="ignore") + "\n" + ubsan_output.stderr.decode("utf-8", errors="ignore")
        raise Exception(f"[!] Error: casr-san and casr-ubsan execute error: {err_msg}")

    crash_report_path = None
    for file in os.listdir(tmp_crash_report_dir):
        if file.endswith("casrep"):
            crash_report_path = os.path.join(tmp_crash_report_dir, file)
            break
    
    if crash_report_path is None:
        shutil.rmtree(tmp_crash_dir)
        raise Exception(f"[!] Error: No crash report can be generated. This crash could not be ASAN bug. Please re-execute the fuzzer with the crash artifact to verify if the crash is reported by other sanitizers or is false-positive.")
    else:
        with open(crash_report_path, 'r') as f:
            crash_json = json.load(f)
            date = crash_json.get('Date', 'N/A')
            executable_path = crash_json.get('ExecutablePath', 'N/A')
            crash_severity = crash_json.get('CrashSeverity', {}).get('ShortDescription', 'N/A')
            crash_line = crash_json.get('CrashLine', 'N/A')
            #crash_description = crash_json.get('CrashSeverity', {}).get('Description', 'N/A')
            #stacktrace = crash_json.get('Stacktrace', [])
            ubsan_report = crash_json.get('UbsanReport', [])
            asan_report = crash_json.get('AsanReport', [])
            source = crash_json.get('Source', 'N/A')
            
            # Output the extracted information
            print("Crash Report Summary:")
            print("----------------------")
            print(f"Date: {date}")
            print(f"Executable Path: {executable_path}")
            print(f"Crash Severity: {crash_severity}")
            print(f"Crash Line: {crash_line}")
            #print(f"Crash Description: {crash_description}")
            print(f"Related Source Code:")
            print("\n".join(source) if source else "No source code available")
            print()
            print("Stacktrace:")
            if ubsan_report:
                print("\n".join(ubsan_report) if ubsan_report else "No stacktrace available")
            if asan_report:
                print("\n".join(asan_report) if asan_report else "No stacktrace available")

    # Clean up the temporary directory
    shutil.rmtree(tmp_crash_dir)
    return 0


def main():
    parser = argparse.ArgumentParser(description='initial analysis of the crash and produce a simple report')
    parser.add_argument('fuzzer_id', type=int, help='The fuzzer instance ID to generate the crash report for. E.g., 000, 001, etc.')
    parser.add_argument('crash_artifact_path', help='Path to the crash artifact')
    args = parser.parse_args()

    crash_artifact_analysis(args.fuzzer_id, args.crash_artifact_path, timeout=60)


if __name__ == '__main__':
    sys.exit(main()) 